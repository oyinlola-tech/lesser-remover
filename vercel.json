{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "APP_ENV": "production",
    "DEBUG": "false",
    "NUMBA_DISABLE_JIT": "1",
    "STORAGE_DRIVER": "vercel",
    "MODEL_CHECKSUM_DISABLED": "1",
    "HOME": "/tmp",
    "XDG_CACHE_HOME": "/tmp"
  }
}
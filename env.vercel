# Vercel Environment Variables
# Copy these into your Vercel Project Settings → Environment Variables
# https://vercel.com/[team]/[project]/settings/environment-variables

# ─── Required ───────────────────────────────────────────────────

# Vercel Blob Storage token (required for STORAGE_DRIVER=vercel)
# Generate at: https://vercel.com/docs/storage/blob
BLOB_READ_WRITE_TOKEN=

# ─── Optional ──────────────────────────────────────────────────

# Storage driver: "local" (default) or "vercel"
STORAGE_DRIVER=vercel

# App metadata
APP_NAME=Utils-tool
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false

# CORS origins for your domain
CORS_ORIGINS=https://tools.oyinlola.site,https://*.vercel.app

# Upload and storage limits
MAX_UPLOAD_SIZE_MB=100

# Job TTL (minutes) — used by the batch job cleanup task
JOB_TTL_MINUTES=30

# ─── System Dependencies on Vercel ──────────────────────────────
# Ghostscript is required for PDF compression and PDF→image conversion.
# Vercel's Python runtime needs a native build. Set up via:
# https://vercel.com/docs/concepts/functions/serverless-functions/runtimes/python
# Or use the "Ghostscript" integration if available.
